<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A192F"> <!-- 🌌 Premium Midnight Blue የጀርባ ቀለም -->

    <!-- 📡 የኦፍላይን ራዳር መፈለጊያ ማዕከል -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btnRadar"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/squircle_radar"
            android:text="🔄 ራዳር ክፈት\n(ያለ ዳታ ፈልግ)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:onClick="startOfflineRadarScan"/>
    </LinearLayout>

    <!-- 💳 የግርጌ 4ቱ ፕሮፌሽናል አይከኖች መፈለጊያ (Tabs Navigation) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#112240"
        android:orientation="horizontal">

        <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="💬 ቻት" android:textColor="#64FFDA" android:background="?android:attr/selectableItemBackground"/>
        <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="🧭 ፍለጋ" android:textColor="#8892B0" android:background="?android:attr/selectableItemBackground"/>
        <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="🛒 ሱቅ" android:textColor="#8892B0" android:background="?android:attr/selectableItemBackground"/>
        <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="💳 ዋሌት" android:textColor="#8892B0" android:background="?android:attr/selectableItemBackground"/>
    </LinearLayout>
</RelativeLayout>
